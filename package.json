{
  "name": "ecopilot",
  "private": true,
  "version": "1.0.0",
  "description": "Agentic AI carbon coach: Gemini reasons, deterministic tools compute, you get a measurable reduction plan.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run test",
    "build:server": "vite build --ssr server/standalone.ts --outDir dist-server",
    "start": "node dist-server/standalone.js",
    "smoke": "node scripts/smoke.mjs",
    "knip": "knip"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "firebase": "^13.1.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "homepage": "https://promptwar-opal.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/chinmaymeshram1-wq/promptwar.git"
  }
}
