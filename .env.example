# Server-side only. Never prefix with VITE_ (that would ship it to the browser).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model. Defaults to gemini-3.5-flash (gemini-3.1-flash-lite is faster).
GEMINI_MODEL=

# Optional: Firebase web config as ONE line of JSON (Analytics + Performance Monitoring).
# Public by design, but kept out of source so it is configurable per deployment.
VITE_FIREBASE_CONFIG=
